<% layout('/layouts/boilerplate') -%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Personalized Wishlist and Trip Planner</h1>
      <p class="text-muted mb-0">Organize saved stays into collections, compare listings, and keep trip notes.</p>
    </div>
    <a href="/listings" class="btn btn-outline-dark">Explore More Listings</a>
  </div>

  <% if (!wishlistItems || wishlistItems.length === 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body py-5 text-center">
        <h4>No saved listings yet</h4>
        <p class="text-muted">Save your favorite villas to start planning future trips.</p>
      </div>
    </div>
  <% } else { %>
    <% Object.keys(groupedCollections).forEach((collectionName) => { %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0"><%= collectionName %></h3>
            <span class="badge text-bg-dark"><%= groupedCollections[collectionName].length %> saved</span>
          </div>

          <div class="row g-4">
            <% groupedCollections[collectionName].forEach((item) => { %>
              <div class="col-lg-6">
                <div class="border rounded-4 p-3 h-100">
                  <div class="d-flex gap-3">
                    <img
                      src="<%= item.listing && item.listing.image ? item.listing.image.url : '/images/default-listing.jpg' %>"
                      alt="<%= item.listing ? item.listing.title : 'Saved listing' %>"
                      style="width: 140px; height: 110px; object-fit: cover; border-radius: 12px;"
                    >
                    <div class="flex-grow-1">
                      <h5 class="mb-1"><%= item.listing ? item.listing.title : 'Listing removed' %></h5>
                      <p class="text-muted mb-1">
                        <%= item.listing ? item.listing.location : 'Location unavailable' %>
                        <% if (item.listing && item.listing.country) { %>, <%= item.listing.country %><% } %>
                      </p>
                      <p class="mb-1"><strong>Price:</strong> Rs. <%= item.listing && item.listing.price ? Number(item.listing.price).toLocaleString('en-IN') : 0 %> / night</p>
                      <p class="mb-0"><strong>Reviews:</strong> <%= item.listing && item.listing.reviews ? item.listing.reviews.length : 0 %></p>
                    </div>
                  </div>

                  <form action="/wishlist/<%= item._id %>?_method=PUT" method="POST" class="mt-3">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Collection</label>
                        <input type="text" name="wishlist[collectionName]" class="form-control" value="<%= item.collectionName %>" required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Trip Note</label>
                        <input type="text" name="wishlist[tripNote]" class="form-control" value="<%= item.tripNote %>" placeholder="Best for family trip">
                      </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                      <% if (item.listing) { %>
                        <a href="/listings/<%= item.listing._id %>" class="btn btn-dark">Open Listing</a>
                      <% } %>
                      <button class="btn btn-outline-secondary">Update</button>
                    </div>
                  </form>

                  <form action="/wishlist/<%= item._id %>?_method=DELETE" method="POST" class="mt-2">
                    <button class="btn btn-outline-danger">Remove from Planner</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
