<% layout('/layouts/boilerplate') -%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">My Trips</h1>
      <p class="text-muted mb-0">Track your booking history and upcoming stays.</p>
    </div>
    <a href="/listings" class="btn btn-outline-dark">Explore Listings</a>
  </div>

  <% if (!bookings || bookings.length === 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body py-5 text-center">
        <h4>No bookings yet</h4>
        <p class="text-muted">Start by booking a stay from the listings page.</p>
      </div>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% bookings.forEach((booking) => { %>
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                  <h4 class="mb-1"><%= booking.listing ? booking.listing.title : 'Listing removed' %></h4>
                  <p class="text-muted mb-1">
                    Host:
                    <%= booking.listing && booking.listing.owner ? booking.listing.owner.username : 'Unknown' %>
                  </p>
                  <p class="text-muted mb-0">
                    <%= booking.listing ? booking.listing.location : 'Location unavailable' %>
                    <% if (booking.listing && booking.listing.country) { %>, <%= booking.listing.country %><% } %>
                  </p>
                </div>
                <span class="badge text-bg-secondary text-capitalize fs-6"><%= booking.status %></span>
              </div>

              <div class="row mt-4">
                <div class="col-md-3"><strong>Check-in:</strong> <%= new Date(booking.checkIn).toLocaleDateString('en-US') %></div>
                <div class="col-md-3"><strong>Check-out:</strong> <%= new Date(booking.checkOut).toLocaleDateString('en-US') %></div>
                <div class="col-md-3"><strong>Total price:</strong> Rs. <%= Number(booking.totalPrice || 0).toLocaleString('en-US') %></div>
                <div class="col-md-3"><strong>Booked on:</strong> <%= new Date(booking.createdAt).toLocaleDateString('en-US') %></div>
              </div>

              <% if (booking.status !== 'cancelled') { %>
                <form action="/bookings/<%= booking._id %>/cancel?_method=PUT" method="POST" class="mt-4">
                  <button class="btn btn-outline-danger">Cancel Booking</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
